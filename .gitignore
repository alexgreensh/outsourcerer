# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Secrets, never commit
.env
*.key
*.pem

# Backups / scratch
*.bak
*.bak-*
*.orig
*.tmp

# Runtime state (Outsourcerer writes jobs/ledger under $HOME/.outsourcerer)
.outsourcerer/

# derived README preview
readme-preview.html

# stray Antigravity CLI session state
.antigravitycli/

# Python bytecode from shim tests
__pycache__/
*.pyc
.torture-scratch/
.outsourcerer/

# Delegate scratch: a background job that dies mid-run leaves its working files behind.
# They are working notes, not shipped code, and they carry internal task names.
plugins/outsourcerer/skills/outsourcerer/scripts/probe_*.sh
plugins/outsourcerer/skills/outsourcerer/scripts/proof_*.sh
plugins/outsourcerer/skills/outsourcerer/scripts/_*_tmp.sh

# Atomic skill-link temp from _osrc_link_skill_into (parity-hermes / parity mirrors). Normally
# lands in ~/.hermes or the Antigravity skills dir and is consumed by an mv; a run interrupted
# between ln and mv can leave one behind. Never a tracked artifact.
.outsourcerer.link.*
.parity-patches/
.test-*/
.test-*
.test-heartbeat-*
.build-notes/
